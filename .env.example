EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional — see README for what this unlocks.
EXPO_PUBLIC_GOOGLE_MAPS_KEY=

# Native Android Google Maps SDK key (build-time only, see .env for details).
GOOGLE_MAPS_API_KEY=

# Twilio credentials for supabase/functions/notify-guardians are NOT read
# from this file — the app never talks to Twilio directly, only the edge
# function does, server-side. They're documented here so their existence is
# discoverable, but the actual values live only as Supabase Edge Function
# secrets, set via `supabase secrets set <NAME>=... --project-ref <project>`
# (or the dashboard), never in this repo:
#   TWILIO_ACCOUNT_SID
#   TWILIO_AUTH_TOKEN
#   TWILIO_WHATSAPP_NUMBER — WhatsApp Business API sender, bare E.164 (e.g.
#                            "+15551234567", no "whatsapp:" prefix — the
#                            function adds that itself)
#   TWILIO_VOICE_NUMBER    — the Twilio number guardian calls are placed
#                            from
