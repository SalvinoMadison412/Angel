EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional — see README for what this unlocks.
EXPO_PUBLIC_GOOGLE_MAPS_KEY=

# Native Android Google Maps SDK key (build-time only, see .env for details).
GOOGLE_MAPS_API_KEY=

# Twilio WhatsApp sandbox — client-visible (EXPO_PUBLIC_ prefix) because
# GuardianFormScreen/GuardiansScreen build a wa.me deep link with these
# directly on-device, the same way they'd appear in any wa.me link shared
# publicly. Not secret: this is the sandbox's own published number and join
# phrase, the same ones printed in the Twilio console for anyone to see.
EXPO_PUBLIC_TWILIO_WHATSAPP_NUMBER=  # e.g. +14155238886 (no "whatsapp:" prefix, no spaces — see toWhatsAppDeepLink in src/lib/whatsapp.ts)
EXPO_PUBLIC_TWILIO_JOIN_MESSAGE=     # e.g. "join mouse-business" — exact sandbox join phrase from the Twilio console

# Server-side ONLY — used by supabase/functions/twilio-status-webhook to
# validate the X-Twilio-Signature header on inbound webhook requests. Must
# NEVER be prefixed with EXPO_PUBLIC_ and must never be read by app.config.js
# or any src/ code — doing either would bundle it into the RN app, which
# would let anyone decompile the APK and forge Twilio webhook requests. Set
# it as a Supabase Edge Function secret (`supabase secrets set
# TWILIO_AUTH_TOKEN=... --project-ref <project>`, or the Supabase dashboard),
# not by adding it to this file's real .env counterpart in a way any client
# code path reads. Listed here only so its presence/purpose is documented
# alongside the other Twilio vars.
TWILIO_AUTH_TOKEN=
